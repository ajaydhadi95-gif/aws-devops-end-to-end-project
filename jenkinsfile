```groovy
pipeline {

    agent any

    environment {
        AWS_REGION  = 'ap-south-1'
        EKS_CLUSTER = 'devops-cluster'
        NAMESPACE   = 'devops-app'

        BACKEND_REPO  = 'backend'
        FRONTEND_REPO = 'frontend'
    }

    options {
        timestamps()
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '10'))
    }

    stages {

        stage('Checkout') {
            steps {
                echo 'Checking out code from GitHub...'

                git branch: 'main',
                    url: 'https://github.com/ajaydhadi95-gif/aws-devops-end-to-end-project.git'
            }
        }

        stage('Terraform') {
            steps {
                dir('terraform-aws') {
                    sh '''
                        echo "Initializing Terraform..."

                        terraform init

                        echo "Validating Terraform..."

                        terraform fmt -check
                        terraform validate

                        echo "Creating Terraform plan..."

                        terraform plan -out=tfplan

                        echo "Applying Terraform..."

                        terraform apply -auto-approve tfplan
                    '''
                }
            }
        }

        stage('Build Backend') {
            steps {
                echo 'Building backend Docker image...'

                sh '''
                    docker build \
                        -t ${BACKEND_REPO}:${BUILD_NUMBER} \
                        ./backend
                '''
            }
        }

        stage('Build Frontend') {
            steps {
                echo 'Building frontend Docker image...'

                sh '''
                    docker build \
                        -t ${FRONTEND_REPO}:${BUILD_NUMBER} \
                        ./cicd-deployment
                '''
            }
        }

        stage('ECR Login') {
            steps {
                sh '''
                    ACCOUNT_ID=$(aws sts get-caller-identity \
                        --query Account \
                        --output text)

                    echo "AWS Account: ${ACCOUNT_ID}"

                    aws ecr get-login-password \
                        --region ${AWS_REGION} | \
                    docker login \
                        --username AWS \
                        --password-stdin \
                        ${ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com
                '''
            }
        }

        stage('Create ECR Repositories') {
            steps {
                sh '''
                    aws ecr describe-repositories \
                        --repository-names ${BACKEND_REPO} \
                        --region ${AWS_REGION} \
                    || aws ecr create-repository \
                        --repository-name ${BACKEND_REPO} \
                        --region ${AWS_REGION}

                    aws ecr describe-repositories \
                        --repository-names ${FRONTEND_REPO} \
                        --region ${AWS_REGION} \
                    || aws ecr create-repository \
                        --repository-name ${FRONTEND_REPO} \
                        --region ${AWS_REGION}
                '''
            }
        }

        stage('Push Images to ECR') {
            steps {
                sh '''
                    ACCOUNT_ID=$(aws sts get-caller-identity \
                        --query Account \
                        --output text)

                    ECR_REGISTRY="${ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com"

                    echo "Tagging backend image..."

                    docker tag \
                        ${BACKEND_REPO}:${BUILD_NUMBER} \
                        ${ECR_REGISTRY}/${BACKEND_REPO}:${BUILD_NUMBER}

                    echo "Tagging frontend image..."

                    docker tag \
                        ${FRONTEND_REPO}:${BUILD_NUMBER} \
                        ${ECR_REGISTRY}/${FRONTEND_REPO}:${BUILD_NUMBER}

                    echo "Pushing backend image..."

                    docker push \
                        ${ECR_REGISTRY}/${BACKEND_REPO}:${BUILD_NUMBER}

                    echo "Pushing frontend image..."

                    docker push \
                        ${ECR_REGISTRY}/${FRONTEND_REPO}:${BUILD_NUMBER}
                '''
            }
        }

        stage('Configure EKS') {
            steps {
                sh '''
                    echo "Connecting kubectl to EKS..."

                    aws eks update-kubeconfig \
                        --region ${AWS_REGION} \
                        --name ${EKS_CLUSTER}

                    echo "Checking EKS nodes..."

                    kubectl get nodes
                '''
            }
        }

        stage('Deploy Kubernetes') {
            steps {
                sh '''
                    echo "Creating/updating Kubernetes resources..."

                    kubectl apply \
                        -f k8s/ \
                        -n ${NAMESPACE}
                '''
            }
        }

        stage('Update Images') {
            steps {
                sh '''
                    ACCOUNT_ID=$(aws sts get-caller-identity \
                        --query Account \
                        --output text)

                    ECR_REGISTRY="${ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com"

                    echo "Updating backend image..."

                    kubectl set image \
                        deployment/backend \
                        backend=${ECR_REGISTRY}/${BACKEND_REPO}:${BUILD_NUMBER} \
                        -n ${NAMESPACE}

                    echo "Updating frontend image..."

                    kubectl set image \
                        deployment/frontend \
                        frontend=${ECR_REGISTRY}/${FRONTEND_REPO}:${BUILD_NUMBER} \
                        -n ${NAMESPACE}
                '''
            }
        }

        stage('Verify Deployment') {
            steps {
                sh '''
                    echo "Checking Kubernetes pods..."

                    kubectl get pods \
                        -n ${NAMESPACE} \
                        -o wide

                    echo "Checking Kubernetes services..."

                    kubectl get svc \
                        -n ${NAMESPACE}

                    echo "Checking backend rollout..."

                    kubectl rollout status \
                        deployment/backend \
                        -n ${NAMESPACE} \
                        --timeout=300s

                    echo "Checking frontend rollout..."

                    kubectl rollout status \
                        deployment/frontend \
                        -n ${NAMESPACE} \
                        --timeout=300s

                    echo "Deployment verification completed."
                '''
            }
        }
    }

    post {

        success {
            echo '''
            ==========================================
                  DEPLOYMENT SUCCESSFUL
            ==========================================
            '''

            sh '''
                echo "Cluster:"
                echo "${EKS_CLUSTER}"

                echo "Namespace:"
                echo "${NAMESPACE}"

                echo "Pods:"
                kubectl get pods -n ${NAMESPACE} || true

                echo "Services:"
                kubectl get svc -n ${NAMESPACE} || true

                echo "Cleaning unused Docker images..."

                docker image prune -f || true
            '''

            cleanWs()
        }

        failure {
            echo '''
            ==========================================
                    DEPLOYMENT FAILED
            ==========================================
            '''

            sh '''
                echo "Collecting Kubernetes information..."

                kubectl get pods \
                    -n ${NAMESPACE} \
                    -o wide || true

                kubectl get svc \
                    -n ${NAMESPACE} || true

                kubectl get events \
                    -n ${NAMESPACE} \
                    --sort-by=.lastTimestamp \
                    | tail -50 || true
            '''

            cleanWs()
        }

        always {
            echo 'Jenkins pipeline execution completed.'
        }
    }
}
```
